{
  "manifest_version": 3,
  "name": "Context for VK.RU",
  "description": "Создание и редактирование карточек персон и сообществ",
  "version": "0.0.10",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["https://vk.ru/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://vk.ru/*"],
      "js": ["src/core/messaging.js", "src/core/storage.js",
             "src/core/normalize.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "dialog.html" }
}
